# Copia para .env (local) — NUNCA fazer commit do .env.
# No Render, estas variáveis são preenchidas no painel (ver render.yaml / README).

# --- Base de dados ---
# Local: SQLite por omissão. Render: preenchido automaticamente a partir do Postgres do Blueprint.
DATABASE_URL=sqlite:///./observa_dev.db

# --- Acesso à app (produto interno) ---
APP_PASSWORD=muda-isto
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=muda-isto-tambem
# true em produção (HTTPS)
SECURE_COOKIES=false

# --- IA ---
# anthropic | fake  (fake = demo sem rede, só palavras-chave; para trocar/acrescentar Grok ver backend/app/llm/factory.py)
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
# Modelo Claude usado (opcional)
ANTHROPIC_MODEL=claude-haiku-5-5
# Limite de chamadas ao LLM por dia (cada lote de classificação conta 1)
MAX_LLM_CALLS_PER_DAY=200
# Documentos por chamada de classificação
CLASSIFY_BATCH_SIZE=5

# --- Radar ---
# Score mínimo (0-100) para um documento aparecer; ajustável também em Definições
RELEVANCE_THRESHOLD=40
# IPMA: nível mínimo dos avisos a ingerir (yellow | orange | red)
IPMA_MIN_LEVEL=orange
# fogos.pt: nº mínimo de operacionais para ingerir uma ocorrência
FOGOS_MIN_MEN=15

# --- X/Twitter (opcional, desligado por defeito) ---
ENABLE_X=false
X_BEARER_TOKEN=
# X_QUERY=(from:govpt OR from:ProtecaoCivil) -is:retweet lang:pt
